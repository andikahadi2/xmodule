APP_NAME=Affiliate Content Engine
APP_ENV=development
APP_DEBUG=true

DATABASE_URL=postgresql+psycopg://postgres:root@localhost:5432/affiliate_engine

STORAGE_PATH=./storage
DEFAULT_LANGUAGE=id-ID
DEFAULT_VIDEO_WIDTH=1080
DEFAULT_VIDEO_HEIGHT=1920

AI_PROVIDER=openrouter

OPENROUTER_API_KEY=
OPENROUTER_MODEL=liquid/lfm-2.5-2.6b:free

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

PEXELS_API_KEY=

FFMPEG_PATH=ffmpeg

MAX_UPLOAD_SIZE_MB=500

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
APP_BASE_URL=http://localhost:8000

# Leave both blank for local dev (no auth). Set both before hosting publicly —
# the whole app (including static file mounts) will require this login.
ADMIN_USERNAME=
ADMIN_PASSWORD=
